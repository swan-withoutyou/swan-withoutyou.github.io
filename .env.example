# Public site URL used for canonical URLs, sitemap and Open Graph.
# Netlify: set to your Netlify domain (e.g. https://thieu-nang.netlify.app) or custom domain.
NEXT_PUBLIC_SITE_URL=https://swan-withoutyou.github.io
# Optional: Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (empty = analytics off)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Live Road to 1M numbers (no rebuild needed). Raw GitHub URL of the auto-updated metrics file:
# https://raw.githubusercontent.com/<user>/<repo>/<branch>/src/data/metrics/youtube.json
NEXT_PUBLIC_YOUTUBE_METRICS_URL=
# Real-time view count relay (Cloudflare Worker in worker/youtube-live), e.g.
# https://swan-youtube-live.<your-subdomain>.workers.dev/   — empty = 5-minute data only
NEXT_PUBLIC_YOUTUBE_LIVE_URL=
# Optional: only for a GitHub *project* page (e.g. /repo-name). Leave empty for Netlify / user pages.
BASE_PATH=

# ---- Server-side only (never prefix with NEXT_PUBLIC_, never commit real values) ----
# Used by scripts/threads-sync.ts only, never bundled into the static site.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
# YouTube Data API v3 key — store as GitHub Actions secret YOUTUBE_API_KEY (used by scripts/youtube-metrics.ts)
YOUTUBE_API_KEY=
